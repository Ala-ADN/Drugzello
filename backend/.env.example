MEGAN_LOG_LEVEL=INFO
MEGAN_HOST=127.0.0.1
MEGAN_PORT=8000
MEGAN_ENVIRONMENT=development
MEGAN_MODEL_PATH=models/trained/scaffold/model.pth
MEGAN_DATA_PATH=data
